NUXT_CONVEX_DEPLOYMENT=
NUXT_PUBLIC_CONVEX_URL=

NUXT_TELEGRAM_BOT_TOKEN=
NUXT_TELEGRAM_ALLOWED_ID=

NUXT_GEMINI_API_KEY=
NUXT_GEMINI_MODEL=gemini-2.5-pro
NUXT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
NUXT_SYSTEM_PROMPT=

NUXT_OPENROUTER_API_KEY=
NUXT_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
NUXT_OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro
# Private Nitro server asset, relative to server/assets/.
NUXT_OPENROUTER_TTS_REFERENCE_ASSET=voice-reference.mp3
# Optional but recommended: exact transcript of the reference clip.
NUXT_OPENROUTER_TTS_REFERENCE_TEXT=
# Optional for models/providers that require a named voice. Leave blank for cloning.
NUXT_OPENROUTER_TTS_VOICE=

# Shared memory identity. Set either value; NUXT_BOT_USERNAME is preferred.
NUXT_BOT_USERNAME=
NUXT_PUBLIC_BOT_USERNAME=

# Access secrets. Generate them with `node scripts/setup-auth.mjs`, which also
# sets AMBER_SERVER_SECRET and AMBER_AUTH_JWKS on the Convex deployment.
# Server routes -> Convex shared secret (Convex env: AMBER_SERVER_SECRET).
NUXT_CONVEX_SERVER_SECRET=
# Web sign-in password, and the key (32+ chars) that seals the session cookie.
NUXT_AUTH_PASSWORD=
NUXT_SESSION_PASSWORD=
# Base64 PKCS#8 ES256 key for the JWTs browsers hand to Convex.
NUXT_AUTH_JWT_PRIVATE_KEY=
# secret_token registered with Telegram setWebhook.
NUXT_TELEGRAM_WEBHOOK_SECRET=
