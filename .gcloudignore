# Files `gcloud builds submit` leaves out of the upload. Without this file,
# gcloud falls back to .gitignore, which excludes the private voice reference
# in server/assets/ that Nitro must bundle into the image.
.gcloudignore
.git
.gitignore
.output
.data
.nuxt
.nitro
.cache
dist
node_modules
logs
*.log
.DS_Store
.fleet
.idea
.env
.env.*
